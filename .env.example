# Copy this file to .env.local and fill in your key.
# Free key: https://console.groq.com/keys
# On Vercel, set GROQ_API_KEY under Project Settings → Environment Variables (never commit it).
# Without a key, featured topics still work end to end (curated lessons replace AI lessons);
# custom topics and pasted problems need the key.
GROQ_API_KEY=

# Optional: override the model fallback chains (comma-separated, tried in order).
# GROQ_GENERATE_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_VERIFY_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b

# Optional: Postgres for teacher classes (/class). On Vercel, add Neon from Storage → Create Database
# (or the Marketplace); it sets DATABASE_URL for you. Tables are created on first use.
# Without it, development uses an in-memory store and a production build hides classes.
# DATABASE_URL=postgres://user:password@host.neon.tech/neondb?sslmode=require
# CLASS_MEMORY=1   # force the in-memory store in a production build (tests only: data is lost on restart)

# Optional: 1 = canned AI responses (tests and offline development, no key needed).
# LLM_MOCK=1

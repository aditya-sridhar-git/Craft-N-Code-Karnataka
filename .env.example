# Copy this file to .env.local and fill in your key.
# Free key: https://console.groq.com/keys
# Without a key, featured topics still work end to end (curated lessons replace AI lessons);
# custom topics and pasted problems need the key.
GROQ_API_KEY=

# Optional: override the model fallback chains (comma-separated, tried in order).
# GROQ_GENERATE_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b,llama-3.3-70b-versatile
# GROQ_VERIFY_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b,llama-3.3-70b-versatile

# Optional: 1 = canned AI responses (tests and offline development, no key needed).
# LLM_MOCK=1

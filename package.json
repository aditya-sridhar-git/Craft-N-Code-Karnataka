{
  "name": "taproot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:sim": "tsx eval/simulate.ts",
    "eval:llm": "tsx --env-file-if-exists=.env.local eval/llm/run.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "groq-sdk": "1.6.0",
    "katex": "0.19.0",
    "lz-string": "1.5.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "description": "Taproot finds the real reason a student is stuck: it traces a struggling topic down its prerequisite tree to the root gap, then repairs it.",
  "engines": {
    "node": ">=22"
  }
}
